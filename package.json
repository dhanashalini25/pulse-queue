{
  "name": "pulse-queue",
  "version": "1.0.0",
  "description": "PulseQueue — a distributed background job processing platform with queued tasks, worker execution, scheduling, priorities, retries, dead-letter handling, and live monitoring.",
  "main": "src/api/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/api/server.js",
    "start:worker": "node src/worker/worker.js",
    "dev": "nodemon src/api/server.js",
    "dev:worker": "nodemon src/worker/worker.js",
    "seed": "node src/scripts/seed.js",
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": ["queue", "jobs", "bullmq", "redis", "distributed-systems", "background-jobs"],
  "license": "MIT",
  "dependencies": {
    "@bull-board/api": "^5.21.0",
    "@bull-board/express": "^5.21.0",
    "bullmq": "^5.12.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "joi": "^17.13.3",
    "uuid": "^9.0.1",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
